# Copy this file to `.env.local` and fill in values from
# Supabase Dashboard → Project Settings → API.
# These two values are PUBLIC (safe in frontend code). Never put the
# service_role key or any Pesapal secret in this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
